# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Frontend Client Origin (for CORS)
# ==========================================
CLIENT_ORIGIN=https://campuslost-and-found.netlify.app

# ==========================================
# Database Configuration (MongoDB Atlas)
# ==========================================
# Step 1: Create a free cluster on https://cloud.mongodb.com/
# Step 2: Create a database user (e.g., dbAdmin) and password
# Step 3: Set Network Access (IP Access List) to allow access (0.0.0.0/0 for cloud dev)
# Step 4: Copy your connection string into your local .env file (DO NOT commit .env):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
