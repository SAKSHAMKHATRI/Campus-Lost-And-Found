{
  "info": {
    "_postman_id": "b82e4a81-d7fa-4b68-b789-f53835c2e11a",
    "name": "Campus Lost & Found API",
    "description": "Comprehensive Postman API Collection for Campus Lost & Found Backend evaluation. Covers health checks, CRUD operations, query filtering, and validation error cases. Supports both localhost and Render Web Service by toggling the {{baseUrl}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "itemId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Health status indicates service is running\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.include(\"healthy\");",
              "    pm.expect(jsonData).to.have.property(\"uptime\");",
              "    pm.expect(jsonData).to.have.property(\"timestamp\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Verifies that the backend server is up, healthy, and operational."
      },
      "response": []
    },
    {
      "name": "02 - Create Item (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Item report is successfully created\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Item report created successfully\");",
              "    pm.expect(jsonData.data).to.have.property(\"_id\");",
              "    pm.expect(jsonData.data.title).to.include(\"[TEST]\");",
              "    pm.expect(jsonData.data.type).to.eql(\"lost\");",
              "    pm.expect(jsonData.data.status).to.eql(\"open\");",
              "",
              "    // Automatically save created item ID for subsequent requests",
              "    pm.collectionVariables.set(\"itemId\", jsonData.data._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"[TEST] Dell XPS 65W USB-C Charger\",\n  \"type\": \"lost\",\n  \"category\": \"Electronics\",\n  \"description\": \"[TEST RECORD] Left on Desk 14 in Library reading hall. Black braided cable.\",\n  \"location\": \"Library\",\n  \"date\": \"2026-10-25\",\n  \"color\": \"Black\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        },
        "description": "Creates a new lost or found report in MongoDB Atlas and captures its _id into {{itemId}}."
      },
      "response": []
    },
    {
      "name": "03 - List All Items (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns array of items with count\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.count).to.be.a(\"number\");",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        },
        "description": "Retrieves all reported items sorted with the newest entries first."
      },
      "response": []
    },
    {
      "name": "04 - Filter Lost Items (GET ?type=lost)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"All returned items match type 'lost'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "    jsonData.data.forEach(function (item) {",
              "        pm.expect(item.type).to.eql(\"lost\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
